datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum BookingStatus {
  PENDING
  PROPOSED
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
}

enum ServiceStatus {
  DRAFT
  REVIEW
  PUBLISHED
  REVISION
  PAUSED
}

enum AvailabilityStatus {
  AVAILABLE
  CLOSED
}

enum ServicePriceBasis {
  PER_PERSON
  PER_GROUP
  CONTACT
}

enum ItineraryStatus {
  SAVED
  BOOKING_REQUESTED
  PARTIALLY_CONFIRMED
  CONFIRMED
  CANCELLED
  COMPLETED
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  password        String
  name            String
  phone           String?
  role            Role             @default(CUSTOMER)
  avatar          String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  providerProfile ProviderProfile?
  bookings        Booking[]
  reviews         Review[]
  favorites       Favorite[]
  auditLogs       AuditLog[]
  itineraries     Itinerary[]
  aiUsageLogs     AiUsageLog[]

  @@map("users")
}

model ProviderProfile {
  id        String    @id @default(cuid())
  code      String    @unique
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  story     String
  contact   String
  address   String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  services  Service[]
  bookings  Booking[]

  @@map("provider_profiles")
}

model Service {
  id             String          @id @default(cuid())
  code           String          @unique
  providerId     String
  provider       ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name           String
  category       String
  price          Int
  priceBasis     ServicePriceBasis @default(PER_PERSON)
  childPrice     Int?
  duration       Int
  capacity       Int             @default(16)
  image          String
  latitude       Float?
  longitude      Float?
  areaCode       String?
  serviceVerifiedAt  DateTime?
  locationVerifiedAt DateTime?
  testOnly       Boolean         @default(false)
  bookingUnit    String?
  groups         String[]        @default(["family", "friends"])
  indoor         Boolean         @default(false)
  description    String
  status         ServiceStatus   @default(PUBLISHED)
  slots          String[]        @default(["08:30", "10:30", "14:00", "16:00"])
  amenities      String[]        @default([])
  included       String?
  excluded       String?
  conditions     String?
  moderationNote String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  bookings       Booking[]
  reviews        Review[]
  availabilities ServiceAvailability[]
  itineraryStops ItineraryStop[]

  @@map("services")
}

model ServiceAvailability {
  id         String             @id @default(cuid())
  serviceId  String
  service    Service            @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  date       DateTime           @db.Date
  slot       String
  capacity   Int?
  status     AvailabilityStatus @default(AVAILABLE)
  verifiedAt DateTime?
  sourceNote String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([serviceId, date, slot])
  @@index([date, status])
  @@map("service_availability")
}

model Itinerary {
  id                String          @id @default(cuid())
  code              String          @unique
  customerId        String
  customer          User            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  date              String
  adults            Int
  children          Int             @default(0)
  budgetVnd         Int?
  budgetBasis       String
  startTime         String
  endTime           String
  transportMode     String
  originLatitude    Float?
  originLongitude   Float?
  originLabel       String?
  returnLatitude    Float?
  returnLongitude   Float?
  returnLabel       String?
  returnTravelMinutes Int?
  returnDistanceM     Int?
  returnRouteProvider String?
  returnRouteGeometry String?
  totalCostVnd      Int?
  knownCostVnd      Int
  hasUnknownCosts   Boolean         @default(false)
  fallbackMode      String
  status            ItineraryStatus @default(SAVED)
  explanation       String?
  warnings          Json            @default("[]")
  constraints       Json
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  stops ItineraryStop[]

  @@index([customerId, createdAt])
  @@map("itineraries")
}

model ItineraryStop {
  id                       String    @id @default(cuid())
  itineraryId              String
  itinerary                Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  serviceId                String
  service                  Service   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  position                 Int
  date                     String
  slot                     String
  arrivalTime              String
  departureTime            String
  travelFromPreviousMin    Int?
  distanceFromPreviousM    Int?
  routeProvider            String?
  routeGeometry            String?
  estimatedCostVnd         Int?
  costKnown                Boolean   @default(true)
  availabilityCheckedAt   DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  booking                  Booking?

  @@unique([itineraryId, position])
  @@index([serviceId, date, slot])
  @@map("itinerary_stops")
}

model Booking {
  id             String          @id @default(cuid())
  code           String          @unique
  serviceId      String
  service        Service         @relation(fields: [serviceId], references: [id])
  providerId     String
  provider       ProviderProfile @relation(fields: [providerId], references: [id])
  customerId     String
  customer       User            @relation(fields: [customerId], references: [id])
  customerName   String
  customerPhone  String
  notes          String?
  date           String
  slot           String
  people         Int
  price          Int
  total          Int
  netReceivedVnd Int?
  platformFeeVnd Int?
  feeRecordedAt  DateTime?
  feePaidAt      DateTime?
  duration       Int
  status         BookingStatus   @default(PENDING)
  proposalDate   String?
  proposalSlot   String?
  proposalReason String?
  cancelReason   String?
  source         String          @default("Trực tiếp")
  itineraryStopId String?        @unique
  idempotencyKey  String?        @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  history        BookingHistory[]
  review         Review?
  itineraryStop  ItineraryStop?  @relation(fields: [itineraryStopId], references: [id], onDelete: SetNull)

  @@map("bookings")
}

model BookingHistory {
  id        String        @id @default(cuid())
  bookingId String
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status    BookingStatus
  actor     String
  message   String
  createdAt DateTime      @default(now())

  @@map("booking_histories")
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  rating     Int
  text       String
  reply      String?
  replyAt    DateTime?
  status     String   @default("visible")
  createdAt  DateTime @default(now())

  @@map("reviews")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId String
  createdAt DateTime @default(now())

  @@unique([userId, serviceId])
  @@map("favorites")
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  target    String
  detail    String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String
  target    String?
  source    String   @default("Trực tiếp")
  createdAt DateTime @default(now())

  @@map("analytics_events")
}

model AiRateLimit {
  key             String   @id
  count           Int      @default(0)
  windowStartedAt DateTime
  expiresAt       DateTime
  updatedAt       DateTime @updatedAt

  @@index([expiresAt])
  @@map("ai_rate_limits")
}

model AiUsageLog {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  model        String
  mode         String
  outcome      String
  inputTokens  Int?
  outputTokens Int?
  requestId    String
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("ai_usage_logs")
}
