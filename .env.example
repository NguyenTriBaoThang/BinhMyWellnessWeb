# Copy to .env and replace both values with connection strings from Supabase.
# Use Supabase's pooled connection string for the running website.
DATABASE_URL="PASTE_SUPABASE_POOLER_URL_HERE"

# Use the direct connection for reviewed migrations on a development or staging database.
DIRECT_URL="PASTE_SUPABASE_DIRECT_URL_HERE"

# Required in production. Replace this with a unique random value of 32+ characters.
SESSION_SECRET=""

# Set only for disposable local demo seeding. Never seed production.
# Keep this value out of GitHub and do not add it to the browser/client environment.
BM_ADMIN_PASSWORD=""

# Enable only while testing the demo booking flow on a deployed site.
BM_ENABLE_TEST_BOOKINGS="false"
NEXT_PUBLIC_BM_ENABLE_TEST_BOOKINGS="false"

# Server-side itinerary integrations (optional in local fallback mode).
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
GOONG_API_KEY=""
GOONG_DIRECTIONS_URL="https://rsapi.goong.io/v2/direction"
ROUTING_TIMEOUT_MS="5000"

# MapTiler key is used by the browser to load map tiles. Restrict it to your site origins.
NEXT_PUBLIC_MAPTILER_KEY=""
